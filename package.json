{
  "name": "@daracl/drift",
  "version": "0.0.3",
  "description": "Daracl Drift - drag & drop layout editor with a CSS-only viewer",
  "author": {
    "name": "daracl",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "license": "MIT",
  "sideEffects": false,
  "keywords": [
    "@daracl/drift",
    "drift",
    "grid-layout",
    "drag-and-drop",
    "dashboard",
    "gridstack",
    "daracl"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "require": "./dist/core.cjs"
    },
    "./viewer": {
      "types": "./dist/viewer.d.ts",
      "import": "./dist/viewer.js",
      "require": "./dist/viewer.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.drift.umd.js"
    },
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "cpx": "^1.5.0",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "rimraf": "^6.0.1",
    "sass": "^1.80.2",
    "terser": "^5.47.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.9.5",
    "typedoc": "^0.26.7",
    "typescript": "^5.1.6",
    "vite": "^5.4.0",
    "vite-plugin-banner": "^0.7.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run clean && npm run build:esm && npm run build:umd && npm run build:css && npm run build:tsc",
    "build:esm": "vite build --config vite.config.js --mode production",
    "build:umd": "vite build --config vite.config.umd.js --mode production",
    "build:css": "sass --no-source-map style/daracl.drift.scss dist/daracl.drift.css && sass --no-source-map --style=compressed style/daracl.drift.scss dist/daracl.drift.min.css && sass --no-source-map --style=compressed style/daracl.drift.viewer.scss dist/daracl.drift.viewer.min.css",
    "build:tsc": "tsc -p tsconfig-build.json --emitDeclarationOnly && cpx \"src/**/*.d.ts\" dist && tsc-alias -p tsconfig-build.json && node scripts/check-dts.mjs",
    "clean": "rimraf dist",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "pwtest": "playwright test",
    "prepublishOnly": "npm run build",
    "example": "node scripts/build-example.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "bench:core": "node scripts/bench-core.mjs",
    "bench:editor": "node scripts/bench-editor.cjs",
    "check:dts": "node scripts/check-dts.mjs"
  }
}
